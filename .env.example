# Public URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://hajiasal.ir
NEXT_PUBLIC_ADMIN_URL=https://admin.hajiasal.ir
NEXT_PUBLIC_SELLER_URL=https://seller.hajiasal.ir

# App surface for three-folder cPanel deploy:
#   storefront | admin | seller
# Leave unset (or "all") for local single-process dev.
# APP_ROLE=storefront

# MySQL (REQUIRED for production on host)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_db_name
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# Tickets: apply mysql-migrations/009_ticket_chat_enterprise.sql before go-live.
# Seller applications: apply mysql-migrations/010_seller_applications.sql before go-live.
# Daily auto-close cron (cPanel):
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://YOUR_DOMAIN/api/cron/tickets-auto-close
CRON_SECRET=change_me_cron_secret_min_32_chars

# Primary admin phones (OTP login). Comma-separated. Seeded as super_admin.
ADMIN_PRIMARY_PHONES=09351925900,09135201973

# Customer auth (required in production) — same secret on all three apps
AUTH_SESSION_SECRET=change_me_long_random_secret_min_32_chars

# Test OTP — development ONLY (never enable in production)
AUTH_TEST_PHONE=09123456789
AUTH_TEST_OTP=1234

# SMS — Melipayamak (OTP must use dedicated/pattern lane for instant delivery)
SMS_PROVIDER=melipayamak
MELIPAYAMAK_OTP_URL=https://console.melipayamak.com/api/send/otp/YOUR_TOKEN_HERE
# MELIPAYAMAK_OTP_TOKEN=YOUR_TOKEN_HERE
# Fastest path: approved shared pattern (سرویس مشترک) — set bodyId from Melipayamak panel:
# MELIPAYAMAK_BODY_ID=12345
# MELIPAYAMAK_SHARED_URL=https://console.melipayamak.com/api/send/shared/YOUR_TOKEN_HERE
# Or classic REST shared (username/password + same BODY_ID):
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# Only if you intentionally want slow free-text before OTP gateway:
# MELIPAYAMAK_PREFER_SIMPLE=false
# Anti-abuse OTP (strict defaults)
# AUTH_OTP_IP_MAX=3
# AUTH_OTP_PHONE_MAX=2
# AUTH_OTP_COOLDOWN_SEC=120
# AUTH_OTP_GLOBAL_HOURLY=25
# Daily caps (successful SMS):
# AUTH_OTP_PHONE_DAILY=5
# AUTH_OTP_IP_DAILY=8
# AUTH_OTP_DEVICE_DAILY=5
# AUTH_OTP_UNKNOWN_DEVICE_DAILY=2
# Free-text SMS for admin manual send (panel: /admin/sms) — not used for OTP by default
# MELIPAYAMAK_SMS_URL=https://console.melipayamak.com/api/send/simple/YOUR_TOKEN_HERE
# Or for Kavenegar/Ghasedak: SMS_API_KEY= + SMS_SENDER=
# Kavenegar pattern OTP (instant): KAVENEGAR_OTP_TEMPLATE=your-template-name
# Ghasedak pattern OTP: GHASEDAK_OTP_TEMPLATE=your-template-name
# Auto order-status SMS is OFF by default; set to true only if you want it back:
# ORDER_SMS_ENABLED=false

# Payment (optional — storefront only)
ZARINPAL_MERCHANT_ID=
# Local/dev sandbox (any 36-char UUID). Never enable on production.
# ZARINPAL_SANDBOX=true
# ZARINPAL_ACCESS_TOKEN=

# SnappPay installment (optional — storefront only)
# SNAPPPAY_BASE_URL=https://api.snapppay.ir
# SNAPPPAY_CLIENT_ID=
# SNAPPPAY_CLIENT_SECRET=
# SNAPPPAY_USERNAME=
# SNAPPPAY_PASSWORD=

# TRUST_X_FORWARDED_FOR=true
